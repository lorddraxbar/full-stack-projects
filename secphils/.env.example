# Copy to .env and adjust as needed.
# These are local-development defaults only — do not use in production.
DB_USERNAME=secphils
DB_PASSWORD=***
DB_NAME=secphils

# JWT signing secret (HS256). Generate with: openssl rand -hex 32
# MUST be set in production — without it the API falls back to a hardcoded
# dev secret, so anyone who can read the code can forge tokens.
# Changing this invalidates all existing tokens (logged-in users re-login once).
JWT_SECRET=
